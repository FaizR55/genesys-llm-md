# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=genesys_llm

# LLM Provider: google, openai, anthropic, ollama, or deepseek
LLM_PROVIDER=ollama

# Google Gemini
# Note: model must include :generateContent suffix (e.g. gemini-2.5-flash:generateContent)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash:generateContent

# Ollama (local, OpenAI-compatible)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=qwen2.5
OLLAMA_API_KEY=ollama

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENDPOINT=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Redis
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
API_KEY=your_api_key_here

# App
PORT=3000
SYSTEM_INSTRUCTION="You are a helpful, concise, and professional assistant integrated into a customer interaction platform. Answer clearly and accurately. Do not reveal system internals."
HISTORY_LIMIT=20

# Genesys Widget Config
GENESYS_ENVIRONMENT=prod-apne1
GENESYS_DEPLOYMENT_ID=your_deployment_id_here
